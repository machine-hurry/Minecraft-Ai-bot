# ===== DeepSeek =====
# 在 https://platform.deepseek.com/api_keys 创建，只显示一次
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 一般不用改；OpenAI 兼容地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash（快、便宜，推荐）| deepseek-v4-pro（更强、更贵）
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：off 延迟低，适合游戏内对话；on 会“想”很久但复杂任务更准
THINKING=off
# 仅在 THINKING=on 时生效：low | high | max
REASONING_EFFORT=high
TEMPERATURE=0.7
API_TIMEOUT_MS=60000

# ===== Minecraft =====
# 单人存档“对局域网开放”后填 127.0.0.1 + 游戏里显示的端口
MC_HOST=127.0.0.1
MC_PORT=54321
MC_USERNAME=DeepBot
# 局域网/离线服填 offline；正版验证服填 microsoft（会提示设备码登录）
MC_AUTH=offline
# 留空自动识别；识别失败再手填，例如 1.21.4
MC_VERSION=
# 寻路时是否允许挖开挡路的方块（挖矿必须开；怕它挖穿房子就设 off）
CAN_DIG=on
# 聊天前缀：游戏里输入 “!ai 去砍树”
CHAT_PREFIX=!ai 
# 只响应这个玩家（留空 = 所有人）
OWNER=

# ===== AI 行为 =====
# 单条指令最多允许多少轮“模型思考 + 工具执行”
MAX_STEPS=10
# 记住最近多少轮聊天（1 轮 = 玩家一句 + 回复一句）
HISTORY_LIMIT=12
